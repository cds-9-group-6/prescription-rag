# Example environment file for prescription-rag
# Copy this file to .env and modify the values as needed

# Ollama configuration
OLLAMA_HOST=http://192.168.0.100:11434

# Prescription service port
PRESCRIPTION_PORT=8081

# ChromaDB configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# RAG configuration
RAG_MODEL=llama2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Logging configuration
LOG_LEVEL=INFO

# OpenTelemetry configuration
# For local development (use localhost)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# For OpenShift/Kubernetes deployment (use service name)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.sasya-arogya.svc.cluster.local:4317

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=
MLFLOW_REGISTRY_URI=http://localhost:5001

# Optional: API keys and other secrets
# API_KEY=your-api-key-here
# DATABASE_URL=your-database-url-here
