# use localhost if running natively on macbook with python else use host.containers.internal when using podman container for all host.

OLLAMA_HOST=http://0.0.0.0:11434
# OLLAMA_HOST=http://host.containers.internal:11434
OLLAMA_BASE_URL=http://0.0.0.0:11434/v1
# OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
OLLAMA_MODEL=llama3.1:8b

# MLflow Configuration
MLFLOW_TRACKING_URI=http://0.0.0.0:5001
# MLFLOW_TRACKING_URI=http://host.containers.internal:5001
# MLFLOW_EXPERIMENT_NAME=plant_disease_classification
MLFLOW_EXPERIMENT_NAME=llm_tracing_ollama
MLFLOW_ACTIVE_MODEL_NAME=llama318b_model
MLFLOW_ARTIFACT_LOCATION=./mlflow_artifacts
# MLFLOW_REGISTRY_URI=http://0.0.0.0:5001
# MLFLOW_REGISTRY_URI=http://host.containers.internal:5001

# Optional: Configure async logging (recommended for production)
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
MLFLOW_ASYNC_TRACE_LOGGING_MAX_WORKERS=10
MLFLOW_ASYNC_TRACE_LOGGING_MAX_QUEUE_SIZE=1000

# Optional: Configure trace sampling ratio (default is 1.0)
MLFLOW_TRACE_SAMPLING_RATIO=1.0

OTEL_EXPORTER_OTLP_ENDPOINT=http://0.0.0.0:4317
# OTEL_TRACES_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://0.0.0.0:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.containers.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
MLFLOW_TRACE_ENABLE_OTLP_DUAL_EXPORT=false
# see if the integration works without below two variables as mlflow may be setting this up
# Optionally, set the service name to group traces
OTEL_SERVICE_NAME=sasyaarogya
# OTEL_RESOURCE_ATTRIBUTES="service.instance.id=$(uuidgen)"

OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://0.0.0.0:4318/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://host.containers.internal:4318/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://0.0.0.0:9090/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=10000




# Other Configuration
DEBUG=false

LOG_LEVEL=debug


CHROMA_HOST=0.0.0.0
# CHROMA_HOST=host.containers.internal
CHROMA_PORT=8000

# API_HOST=0.0.0.0
# API_HOST=host.containers.internal
API_PORT=8081
API_RELOAD=false
LOG_LEVEL=INFO


OPENAI_MODEL=gpt-4
TEACHER_MODEL_TEMPERATURE=0.6
TEACHER_MODEL_TOKEN_OUT=1500
